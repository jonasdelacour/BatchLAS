{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 14,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev",
      "description": "Default RelWithDebInfo SYCL build.",
      "binaryDir": "${sourceDir}/build/presets/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BATCHLAS_BUILD_TESTS": "OFF",
        "BATCHLAS_BUILD_BENCHMARKS": "OFF",
        "BATCHLAS_BUILD_PYTHON": "OFF"
      }
    },
    {
      "name": "dev-tests",
      "displayName": "Dev Tests",
      "description": "RelWithDebInfo build with tests enabled.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/dev-tests",
      "cacheVariables": {
        "BATCHLAS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "fast-dev",
      "displayName": "Fast Dev",
      "description": "RelWithDebInfo build for iteration: batchlas plus a smoke-test subset.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/fast-dev",
      "cacheVariables": {
        "BATCHLAS_BUILD_TESTS": "ON",
        "BATCHLAS_TEST_TARGET_SET": "smoke"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Benchmarks",
      "description": "Build benchmarks and tuning support.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/benchmarks",
      "cacheVariables": {
        "BATCHLAS_BUILD_BENCHMARKS": "ON",
        "BATCHLAS_ENABLE_TUNING": "ON"
      }
    },
    {
      "name": "cuda",
      "displayName": "CUDA",
      "description": "Optional CUDA-enabled build when the environment supports it.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/cuda",
      "cacheVariables": {
        "BATCHLAS_ENABLE_CUDA": "AUTO",
        "BATCHLAS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-gpu",
      "displayName": "Dev (GPU only)",
      "description": "Fast iteration: drops the native_cpu SYCL target. ~30% off every compile and every device link. GPU coverage ONLY - see dev-tests for the full build.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/dev-gpu",
      "cacheVariables": {
        "BATCHLAS_CPU_TARGET": "none"
      }
    },
    {
      "name": "dev-gpu-tests",
      "displayName": "Dev Tests (GPU only)",
      "description": "dev-gpu plus tests. Roughly half of every typed suite is not instantiated and ctest still reports green - do not use as a pre-push gate.",
      "inherits": "dev-gpu",
      "binaryDir": "${sourceDir}/build/presets/dev-gpu-tests",
      "cacheVariables": {
        "BATCHLAS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": [
        "batchlas_components"
      ]
    },
    {
      "name": "dev-tests",
      "configurePreset": "dev-tests"
    },
    {
      "name": "fast-dev",
      "configurePreset": "fast-dev",
      "targets": [
        "batchlas_components",
        "batchlas_smoke_tests"
      ]
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "targets": [
        "batchlas_components",
        "batchlas_benchmarks"
      ]
    },
    {
      "name": "cuda",
      "configurePreset": "cuda"
    },
    {
      "name": "dev-gpu",
      "configurePreset": "dev-gpu",
      "targets": [
        "batchlas_components"
      ]
    },
    {
      "name": "dev-gpu-tests",
      "configurePreset": "dev-gpu-tests"
    }
  ],
  "testPresets": [
    {
      "name": "fast-dev",
      "configurePreset": "fast-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-tests",
      "configurePreset": "dev-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "dev-gpu-tests",
      "configurePreset": "dev-gpu-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
