#!/bin/sh
set -eu

# Convenience launcher for profiling GEMM benchmark with terminal summary.
# Usage:
#   ./roc_benchmark M N K B [extra gemm_benchmark args]
# Example:
#   ./roc_benchmark 128 128 128 128 --type=float --backend=ROCM

if [ "$#" -lt 4 ]; then
  echo "Usage: $0 M N K B [extra args]" >&2
  exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$script_dir/rocprof_nvprof_like.sh" "$script_dir/../build/benchmarks/gemm_benchmark" "$@"
