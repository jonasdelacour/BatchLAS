+MetalEmitter::~MetalEmitter() = default;
+
+// The IR an MSL line came from, as a trailing comment. Off unless the MSL is being read
+// (__ACPP_PRINT_METAL_CODE or __ACPP_METAL_IR_COMMENTS): in a large kernel the comments are
+// most of the source the Metal compiler has to parse.
+std::string MetalEmitter::instToString(const Instruction& I) {
+  if (!irComments) {
+    return {};
+  }
+  std::string str;
+  raw_string_ostream rso(str);
+  if (slots && I.getFunction() == slotFunction) {
+    I.print(rso, *slots);
+  } else {
+    I.print(rso);
+  }
+  return rso.str();
+}
