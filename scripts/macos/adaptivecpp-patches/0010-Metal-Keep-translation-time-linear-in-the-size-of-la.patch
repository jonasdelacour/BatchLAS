+// Moves every PHI to a stack slot (stores in the predecessors, a load in its block) without
+// splitting critical edges, unlike RegToMem: StructurizeCFG then has no PHIs to repair.
+struct DemotePHIsToStack : llvm::PassInfoMixin<DemotePHIsToStack> {
+  llvm::PreservedAnalyses run(llvm::Function& F, llvm::FunctionAnalysisManager&) {
+    if (F.isDeclaration())
+      return llvm::PreservedAnalyses::all();
+    llvm::SmallVector<llvm::PHINode*, 64> PHIs;
+    for (auto& BB : F)
+      for (auto& PN : BB.phis())
+        PHIs.push_back(&PN);
+    if (PHIs.empty())
+      return llvm::PreservedAnalyses::all();
+    const auto AllocaPoint = F.getEntryBlock().getFirstInsertionPt();
+    for (auto* PN : PHIs)
+      llvm::DemotePHIToStack(PN, AllocaPoint);
+    llvm::PreservedAnalyses PA;
+    PA.preserveSet<llvm::CFGAnalyses>();
+    return PA;
+  }
+};
+
 struct ExpandIntrinsics : llvm::PassInfoMixin<ExpandIntrinsics> {
   llvm::PreservedAnalyses run(llvm::Function& F, llvm::FunctionAnalysisManager& FAM) {
     llvm::SmallVector<llvm::IntrinsicInst*, 16> Work;
@@ -680,7 +702,15 @@ bool LLVMToMetalTranslator::translateToBackendFormat(llvm::Module& FlavoredModul
     FPM.addPass(llvm::LCSSAPass());
     FPM.addPass(llvm::DCEPass());
     FPM.addPass(llvm::ADCEPass());
+    // StructurizeCFG repairs every PHI it reroutes with its own SSAUpdater, and each query
+    // scans every PHI of every block it walks. A fully unrolled kernel with many wide joins
+    // (BatchLAS's register-resident posv at order 28-32: ~1300 blocks, ~6400 PHIs) then spends
+    // minutes there. With the PHIs in stack slots it has none to repair, and mem2reg rebuilds
+    // SSA on the structured CFG in near-linear time.
+    FPM.addPass(DemotePHIsToStack());
     FPM.addPass(llvm::StructurizeCFGPass());
+    FPM.addPass(llvm::PromotePass());
+    FPM.addPass(llvm::LCSSAPass());
     // Since LLVM 22 this pass removes the Flow blocks that StructurizeCFG creates,
     // so a loop gets more than one exit again. HLExtractorPass needs exactly one
     FPM.addPass(llvm::SimplifyCFGPass(llvm::SimplifyCFGOptions().setSimplifyCondBranch(false)));
