 std::string MetalEmitter::valueName(const Value* V) {
+  const Function* owner = nullptr;
+  if (auto* I = dyn_cast<Instruction>(V)) {
+    owner = I->getFunction();
+  } else if (auto* A = dyn_cast<Argument>(V)) {
+    owner = A->getParent();
+  }
+  const bool local = owner && owner == slotFunction && slots;
+  if (local) {
+    auto it = localNames.find(V);
+    if (it != localNames.end()) {
+      return it->second;
+    }
+  }
   std::string s;
   raw_string_ostream rso(s);
-  V->printAsOperand(rso, false);
+  if (local) {
+    V->printAsOperand(rso, false, *slots);
+  } else {
+    V->printAsOperand(rso, false);
+  }
   std::string name = rso.str();
   if (name[0] == '%') {
     name = name.substr(1);
@@ -1435,14 +1476,30 @@ std::string MetalEmitter::valueName(const Value* V) {
       c = '_';
     }
   }
-  return "t" + name;
+  name = "t" + name;
+  if (local) {
+    constexpr std::size_t MaxNameLength = 48;
+    if (name.size() > MaxNameLength) {
+      name.resize(MaxNameLength / 2);
+    }
+    const std::string base = name;
+    while (!usedLocalNames.insert(name).second) {
+      name = base + "_u" + std::to_string(nextLocalNameSuffix++);
+    }
+    localNames.emplace(V, name);
+  }
+  return name;
 }
 
