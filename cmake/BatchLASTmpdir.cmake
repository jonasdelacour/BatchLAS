# A private TMPDIR for every compile and link.
#
# The DPC++ driver writes its device temporaries (<tu>-sm_89-<hash>.{bc,s,o,cubin}, hundreds
# of MB per device link) to $TMPDIR, default /tmp. On a tmpfs /tmp that is RAM, and a link
# that is killed, fails or otherwise skips its cleanup leaves them there: about 12 GiB/day
# leaked on a box with zero swap. The generated <build>/batchlas-tmpdir runs its arguments
# with TMPDIR set to a fresh directory under <build>/.tmp (disk, not RAM), removes it when
# the command exits and keeps the command's exit status. It deliberately does not `exec`, or
# the EXIT trap that removes the directory would never run.
#
# Links: RULE_LAUNCH_LINK. Compiles: the ccache wrapper runs through it
# (cmake/BatchLASCcache.cmake), and without ccache it is the compiler launcher itself.
# TMPDIR is not part of ccache's hash, so the hit rate is unchanged. A SIGKILLed command
# (OOM) still leaves its directory, but on disk, and the next command removes directories
# untouched for a day. `rm -rf <build>/.tmp` is safe whenever no build of the tree runs.
# Must be included before BatchLASCcache.cmake.

option(BATCHLAS_PRIVATE_TMPDIR
    "Run every compile and link with TMPDIR in a per-command directory under <build>/.tmp, removed afterwards (keeps DPC++ device temporaries out of a tmpfs /tmp)"
    ON)

set(BATCHLAS_TMPDIR_LAUNCHER "")
if(NOT BATCHLAS_PRIVATE_TMPDIR OR NOT UNIX OR NOT CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
    return()
endif()

set(_batchlas_tmp_base "${CMAKE_BINARY_DIR}/.tmp")
file(MAKE_DIRECTORY "${_batchlas_tmp_base}")
# Single-quoted in sh: a quote in the build path becomes '\''.
string(REPLACE "'" "'\\''" _batchlas_tmp_base_sh "${_batchlas_tmp_base}")
file(WRITE "${CMAKE_BINARY_DIR}/CMakeFiles/batchlas-tmpdir-stage/batchlas-tmpdir"
    "#!/bin/sh\n"
    "# Generated by cmake/BatchLASTmpdir.cmake - do not edit.\n"
    "base='${_batchlas_tmp_base_sh}'\n"
    "mkdir -p \"$base\" 2>/dev/null\n"
    "find \"$base\" -mindepth 1 -maxdepth 1 -mmin +1440 -exec rm -rf {} + 2>/dev/null\n"
    "# No private directory, no reason to fail the build: run the command as before.\n"
    "d=$(mktemp -d \"$base/t.XXXXXXXX\" 2>/dev/null) || exec \"$@\"\n"
    "trap 'rm -rf \"$d\"' EXIT\n"
    "trap 'exit 129' HUP\n"
    "trap 'exit 130' INT\n"
    "trap 'exit 143' TERM\n"
    "TMPDIR=$d\n"
    "export TMPDIR\n"
    "\"$@\"\n"
    "rc=$?\n"
    "exit $rc\n"
)
file(COPY "${CMAKE_BINARY_DIR}/CMakeFiles/batchlas-tmpdir-stage/batchlas-tmpdir"
    DESTINATION "${CMAKE_BINARY_DIR}"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(BATCHLAS_TMPDIR_LAUNCHER "${CMAKE_BINARY_DIR}/batchlas-tmpdir")

# GLOBAL is safe only because this is the top-level project (checked above). Quoted: the
# generators paste the value verbatim in front of the link command.
set_property(GLOBAL PROPERTY RULE_LAUNCH_LINK "\"${BATCHLAS_TMPDIR_LAUNCHER}\"")
message(STATUS "Private TMPDIR per compile and link: ${_batchlas_tmp_base} (BATCHLAS_PRIVATE_TMPDIR)")
unset(_batchlas_tmp_base)
unset(_batchlas_tmp_base_sh)
