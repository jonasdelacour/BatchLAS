#pragma once

// This file is auto-generated by CMake - do not edit manually
// It contains compile-time configuration for available backends

// HOST backend (netlib BLAS/LAPACK)
#cmakedefine01 BATCHLAS_HAS_HOST_BACKEND

// GPU backends determined at configure time
#cmakedefine01 BATCHLAS_HAS_CUDA_BACKEND
#cmakedefine01 BATCHLAS_HAS_ROCM_BACKEND

// Whether CPU SYCL kernel targets are compiled
#cmakedefine01 BATCHLAS_HAS_CPU_TARGET

// SYCL implementation (cmake BATCHLAS_SYCL_IMPL). Source code tests these, never
// __ACPP__ or SYCL_IMPLEMENTATION_ONEAPI directly.
#cmakedefine01 BATCHLAS_SYCL_IMPL_DPCPP
#cmakedefine01 BATCHLAS_SYCL_IMPL_ACPP

// Whether batchlas::Settings::unsafe may be set from the process environment
// (cmake option BATCHLAS_ALLOW_UNSAFE_ENV, default OFF). 0 means settings()
// pins those fields to their safe values and warns once per variable naming the
// option, so BATCHLAS_SKIP_POINTER_CHECKS cannot disarm the USM check,
// BATCHLAS_LATRD_GRID_FORCE_UNSAFE cannot lift the co-residency cap, and
// BATCHLAS_BLAS_HEALTH=off cannot skip the host-dgemm correctness probe.
//
// #cmakedefine01, like every flag in this header: the macro is ALWAYS defined,
// to 0 or to 1. Test it with `#if`, never `#ifdef` -- an #ifdef here is true in
// both builds, which is how a guarded test compiles to nothing in the
// configuration everyone uses. tests/settings_tests.cc #errors if this header
// was not reached, for exactly that reason.
#cmakedefine01 BATCHLAS_ALLOW_UNSAFE_ENV

// ---------------------------------------------------------------------------
// Vendor math libraries present -- the third dispatch axis (WP0 step S1).
//
// Separate from the family flags above on purpose. A family flag says which
// SYCL device a queue can target; these say whether somebody else's math code
// is available to call. They are currently only INFORMATIONAL: no C++ reads
// them yet, and the family flags keep their old derivation, so this step does
// not change any behaviour. What they enable is asking "is cuSOLVER here?"
// without that being the same question as "is there a CUDA backend?".
#cmakedefine01 BATCHLAS_HAS_CUBLAS
#cmakedefine01 BATCHLAS_HAS_CUSOLVER
#cmakedefine01 BATCHLAS_HAS_CUSPARSE
#cmakedefine01 BATCHLAS_HAS_ROCBLAS
#cmakedefine01 BATCHLAS_HAS_ROCSOLVER
#cmakedefine01 BATCHLAS_HAS_ROCSPARSE
#cmakedefine01 BATCHLAS_HAS_LAPACKE
#cmakedefine01 BATCHLAS_HAS_CBLAS

#if BATCHLAS_HAS_CUBLAS || BATCHLAS_HAS_ROCBLAS || BATCHLAS_HAS_LAPACKE
  #define BATCHLAS_HAS_ANY_VENDOR 1
#else
  #define BATCHLAS_HAS_ANY_VENDOR 0
#endif

// OPENBLAS_CORETYPE value that the configure-time BLAS health check found to be
// required for the host BLAS to compute dgemm correctly (see
// cmake/BatchLASBlasHealthCheck.cmake). Empty when nothing was needed or the
// check did not run. The host backend re-verifies this at runtime, because an
// install tree is routinely used on a machine other than the one that built it.
#define BATCHLAS_REQUIRED_OPENBLAS_CORETYPE "@BATCHLAS_OPENBLAS_CORETYPE@"

// Helper macros for conditional compilation
#if BATCHLAS_HAS_CUDA_BACKEND
  #define BATCHLAS_IF_CUDA(x) x
#else
  #define BATCHLAS_IF_CUDA(x)
#endif

#if BATCHLAS_HAS_ROCM_BACKEND
  #define BATCHLAS_IF_ROCM(x) x
#else
  #define BATCHLAS_IF_ROCM(x)
#endif

// For convenience - define if any GPU backend is available
#if BATCHLAS_HAS_CUDA_BACKEND || BATCHLAS_HAS_ROCM_BACKEND
  #define BATCHLAS_HAS_GPU_BACKEND 1
#else
  #define BATCHLAS_HAS_GPU_BACKEND 0
#endif
