# BatchLAS documentation site. Only non-default settings are listed.
#
# Run through scripts/build_docs.sh (or the CMake target batchlas_docs), which
# runs from the repository root, generates the database pages and exports the
# three variables below. Running `doxygen docs/Doxyfile` by hand from the root
# also works; the generated pages are then missing.
#
# Pinned to Doxygen 1.18 (MARKDOWN_ID_STYLE=GITHUB is what keeps every
# `evidence: docs/<page>.md#<anchor>` pointer a live link; see
# docs/developer/documentation.md#anchors-are-the-contract).

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = BatchLAS
PROJECT_NUMBER         = $(BATCHLAS_VERSION)
PROJECT_BRIEF          = "Batched dense and sparse linear algebra for SYCL"
PROJECT_LOGO           = BatchLAS_logo_transparent.png
OUTPUT_DIRECTORY       = $(BATCHLAS_DOCS_OUT)
CREATE_SUBDIRS         = NO

# ---------------------------------------------------------------- parsing ----
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = YES
GROUP_NESTED_COMPOUNDS = YES
INLINE_SIMPLE_STRUCTS  = NO
TYPEDEF_HIDES_STRUCT   = NO
NUM_PROC_THREADS       = 0

# Math in docs pages uses Doxygen \f$ ... \f$ / \f[ ... \f] (rendered by MathJax).
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = chtml

ALIASES                = "evidence{1}=@par Evidence^^@ref \1" \
                         "invariant=@par Invariant^^" \
                         "trap=@par Trap^^"

# --------------------------------------------------------------- extraction --
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
# API pages open with the detailed docs (DoxygenLayout.xml drops the summary lists), so every
# member needs a detailed entry even when it only has a brief.
ALWAYS_DETAILED_SEC    = YES
REPEAT_BRIEF           = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = SYSTEM
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SHOW_USED_FILES        = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
LAYOUT_FILE            = docs/theme/DoxygenLayout.xml

# ------------------------------------------------------------------ warnings -
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = $(BATCHLAS_DOCS_WARN_AS_ERROR)
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = $(BATCHLAS_DOCS_OUT)/doxygen-warnings.log

# --------------------------------------------------------------------- input -
# Order matters: the tree view lists top-level pages in input order, and the
# section pages in docs/pages/ own the hierarchy through \subpage.
INPUT                  = docs/pages/index.md \
                         docs/pages \
                         .github/README.md \
                         docs \
                         examples/consumer/README.md \
                         python/examples/README.md \
                         benchmarks/benchviz/README.md \
                         evaluation/README.md \
                         evaluation/tuning/README.md \
                         tests/README.md \
                         tuned/README.md \
                         tools/tune/README.md \
                         include/batchlas.hh \
                         include/batchlas \
                         src/select \
                         src/ops \
                         $(BATCHLAS_DOCS_GENERATED)
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hh *.h *.md *.dox
RECURSIVE              = YES
EXCLUDE                = docs/theme \
                         docs/_inbox \
                         docs/tools
EXCLUDE_PATTERNS       = */minibench.hh \
                         */minibench_structured.hh \
                         */bench_structured.hh
EXCLUDE_SYMBOLS        = batchlas::sig \
                         batchlas::linalg::sig \
                         BATCHLAS_CHECK_ARGS \
                         BATCHLAS_ARG_NAMES_* \
                         MINI_ACC_* \
                         MINI_BENCH_* \
                         *EmptyBracesAreAmbiguous
EXAMPLE_PATH           = examples \
                         tests \
                         include
EXAMPLE_RECURSIVE      = YES
IMAGE_PATH             = . \
                         docs
USE_MDFILE_AS_MAINPAGE = docs/pages/index.md
IMPLICIT_DIR_DOCS      = NO

# ------------------------------------------------------------ source browser -
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES
CLANG_ASSISTED_PARSING = NO

# ---------------------------------------------------------------------- html -
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_HEADER            = docs/theme/header.html
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome/doxygen-awesome.css \
                         docs/theme/batchlas.css
HTML_EXTRA_FILES       = docs/theme/doxygen-awesome/doxygen-awesome-darkmode-toggle.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-fragment-copy-button.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-paragraph-link.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-interactive-toc.js \
                         docs/theme/doxygen-awesome/doxygen-awesome-tabs.js \
                         docs/theme/bl-site.js
HTML_COLORSTYLE        = LIGHT
HTML_COPY_CLIPBOARD    = NO
HTML_DYNAMIC_SECTIONS  = YES
HTML_CODE_FOLDING      = YES
HTML_INDEX_NUM_ENTRIES = 1
DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = NO
FULL_SIDEBAR           = NO
TREEVIEW_WIDTH         = 300
PAGE_OUTLINE_PANEL     = NO
SEARCHENGINE           = NO
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

# ------------------------------------------------------------- preprocessor --
# One documentation configuration: a CUDA + host build with every vendor
# library. The generated backend_config.h is not in the source tree, so the
# flags it would define are spelled out here. BATCHLAS_API is the generated
# export macro; unexpanded it becomes the class name.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = BATCHLAS_DOXYGEN \
                         BATCHLAS_API= \
                         BATCHLAS_NO_GLOBAL_NAMES \
                         "BATCHLAS_DISPATCH_ON_QUEUE(x)=" \
                         "BATCHLAS_ACCEPT_OWNING(x)=" \
                         "BATCHLAS_ACCEPT_OWNING_NB(x)=" \
                         BATCHLAS_HAS_HOST_BACKEND=1 \
                         BATCHLAS_HAS_CUDA_BACKEND=1 \
                         BATCHLAS_HAS_ROCM_BACKEND=0 \
                         BATCHLAS_HAS_MKL_BACKEND=0 \
                         BATCHLAS_HAS_CUBLAS=1 \
                         BATCHLAS_HAS_CUSOLVER=1 \
                         BATCHLAS_HAS_CUSPARSE=1 \
                         BATCHLAS_HAS_LAPACKE=1 \
                         BATCHLAS_HAS_CBLAS=1 \
                         BATCHLAS_HAS_ANY_VENDOR=1
EXPAND_AS_DEFINED      = BATCHLAS_DENSE_VIEW
SKIP_FUNCTION_MACROS   = YES

# -------------------------------------------------------------------- graphs -
# Graphviz is optional; the site is complete without it.
HAVE_DOT               = $(BATCHLAS_DOCS_HAVE_DOT)
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
