+// ===========================================================================
+// V3 -- THE COOPERATIVE CTA SOLVE.
+//
+// WHY IT EXISTS. V1 gives one work-item a whole solve, so the solution vector
+// is x[N] in that thread's registers and the order is capped by the register
+// file: N=64 was re-measured after the staging tile landed and still produces a
+// 456 B stack frame (float, Side::Left), i.e. x[] in local memory. That cap is
+// what pins V2's block width, and the block width is what decides the traffic:
+// B elements touched per batch item at n=512, in units of q,
+//
+//   nb=32 -> 5824    nb=32 two-level -> 4096    nb=64 -> 3328    nb=128 -> 2560
+//
+// against an ideal of 1024. The measured consequence was float Side::Left at
+// 0.76-0.86x for order >= 256 once q*batch passes 524288.
+//
+// So the array is SPLIT: W work-items cooperate on one solve, thread w owning
+// the canonical rows {w, w+W, w+2W, ...} and holding NL = N/W accumulators.
+// At N=128, W=8 that is 16 elements per thread -- half of what V1 holds at
+// N=32, for four times the order.
+//
+// THE LOOP ORDER IS THE WHOLE TRICK, and the obvious orders do not work:
+//
+//   * A runtime `acc[t/W]` to reach the owner's element puts acc in local
+//     memory, which is the exact failure this kernel exists to avoid.
+//   * Scanning the local array for the owned row costs a predicated pass per
+//     step: N*NL operations against an ideal N^2/(2W), i.e. 2x.
+//   * BLOCK distribution (thread w owns [w*NL, (w+1)*NL)) makes the owner index
+//     compile-time but is 7x load-imbalanced at W=8, since row i costs i fmas.
+//
+// Cyclic distribution with the LOCAL INDEX OUTERMOST is exact. Writing
+// t = wblk + m*W and unrolling m, the owner's local index IS m -- compile time
+// -- and thread w's own rows are i = w + nn*W, so
+//
+//     i > t  <=>  nn > m,  or  nn == m and w > wblk
+//
+// splits into a compile-time loop bound plus one uniform runtime predicate.
+// Every fma executed is a needed one: the work comes out at exactly
+// W * sum_m (NL - m) = N^2/(2W) per thread, with no predication overhead.
+//
+// COALESCING COMES FROM THE LANE MAP, not from a staging tile. With
+// w = lane % W the eight lanes of a Side::Left solve read eight CONSECUTIVE
+// rows of one column -- 8 floats = 32 B = exactly one sector -- so a warp
+// covers four solves in four sectors, which is what a fully coalesced 128 B
+// access costs. That is why V3 does not carry the S3.4 staging tile that V1
+// needs: at W=8 the distribution already is the transpose.
+//
+// (The same lane map is WRONG for Side::Right, where consecutive lanes would
+// want consecutive columns instead; V3 is therefore Side::Left only, which is
+// also the only side with a measured gap.)
+// ===========================================================================
+template <typename T, int N, int W, Side SideV>
+class TrsmCoopKernel;
+
+template <typename T, int N, int W, Side SideV>
+Event trsm_native_coop(Queue& ctx,
+                       const MatrixView<T, MatrixFormat::Dense>& A,
+                       const MatrixView<T, MatrixFormat::Dense>& B,
+                       T alpha,
+                       Uplo uplo,
+                       Transpose transA,
+                       Diag diag) {
+    using D = typename sycl_device::DevMap<T>::type;
+    static_assert(N % W == 0, "the cyclic distribution requires W | N");
+    static_assert(32 % W == 0, "a solve must not straddle a sub-group boundary");
+    static_assert(SideV == Side::Left, "V3 is Side::Left only; see the lane-map note");
+    constexpr int NL = N / W;
+
+    const Canonical can = canonicalise(SideV, uplo, transA, diag);
+
+    const int n = static_cast<int>(A.rows());
+    const int q = static_cast<int>(B.cols());
+    const int bs = static_cast<int>(A.batch_size());
+
+    const auto dev = ctx.device();
+    const int max_wg = static_cast<int>(dev.get_property(DeviceProperty::MAX_WORK_GROUP_SIZE));
+    const int cu = static_cast<int>(dev.get_property(DeviceProperty::MAX_COMPUTE_UNITS));
+
+    // The ladder counts SOLVES, not work-items: a group of `wg` threads serves
+    // wg/W solves, so the grid is batch * ceil(q / (wg/W)).
+    int wg = W * 32;
+    for (int cand : {1024, 512, 256, W * 32}) {
+        if (cand > max_wg || cand % W != 0) continue;
+        wg = cand;
+        const int64_t solves = cand / W;
+        const int64_t groups_c = (q + solves - 1) / solves;
+        if (static_cast<int64_t>(bs) * groups_c >= static_cast<int64_t>(4) * cu) break;
+    }
+    const int solves_per_group = wg / W;
+    const int groups = (q + solves_per_group - 1) / solves_per_group;
+    const size_t tri_elems = static_cast<size_t>(N) * (N + 1) / 2;
+
+    ctx->submit([&](sycl::handler& h) {
+        sycl::local_accessor<D, 1> lc(sycl::range<1>(tri_elems), h);
+        sycl::local_accessor<D, 1> rd(sycl::range<1>(N), h);
+        sycl::local_accessor<int, 1> use_div(sycl::range<1>(1), h);
+
+        const D* a_ptr = reinterpret_cast<const D*>(A.data_ptr());
+        D* b_ptr = reinterpret_cast<D*>(B.data_ptr());
+        const int lda = static_cast<int>(A.ld());
+        const int ldb = static_cast<int>(B.ld());
+        const int stride_a = static_cast<int>(A.stride());
+        const int stride_b = static_cast<int>(B.stride());
+
+        const bool do_trans = can.do_trans;
+        const bool do_conj = can.do_conj;
+        const bool fwd = can.fwd;
+        const bool unit = can.unit;
+
+        D alpha_d;
+        __builtin_memcpy(&alpha_d, &alpha, sizeof(D));
+
+        h.parallel_for<TrsmCoopKernel<T, N, W, SideV>>(
+            sycl::nd_range<1>(sycl::range<1>(static_cast<size_t>(bs) * groups * wg),
+                              sycl::range<1>(wg)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
+                const int wg_id = static_cast<int>(it.get_group_linear_id());
+                const int b = wg_id / groups;
+                const int lid = static_cast<int>(it.get_local_linear_id());
+                const int w = lid % W;              // position within the solve
+                const int jl = lid / W;             // solve index within the group
+                const int u = (wg_id % groups) * solves_per_group + jl;
+                const bool live = (u < q);
+
+                const D* Ab = a_ptr + static_cast<std::ptrdiff_t>(b) * stride_a;
+                D* Bb = b_ptr + static_cast<std::ptrdiff_t>(b) * stride_b;
+
+                D* sLc = lc.template get_multi_ptr<sycl::access::decorated::no>().get();
+                D* sRd = rd.template get_multi_ptr<sycl::access::decorated::no>().get();
+                int* sDiv = use_div.template get_multi_ptr<sycl::access::decorated::no>().get();
+
+                if (lid == 0) sDiv[0] = 0;
+
+                // ---- Stage the canonical triangle --------------------------
+                // Row-then-column, NOT the flat index with a linear search for
+                // the row that V1 uses: that search is O(row) per element, and
+                // at N=128 with 8256 elements it would cost more than the solve.
+                for (int sr = 0; sr < N; ++sr) {
+                    for (int t = lid; t <= sr; t += wg) {
+                        D v;
+                        if (sr >= n || t >= n) {
+                            v = (sr == t) ? sycl_device::dev_one<D>() : D{};
+                        } else {
+                            const int rs = fwd ? sr : (n - 1 - sr);
+                            const int rt = fwd ? t : (n - 1 - t);
+                            // Side::Left: Lc(s,t) = opA(rho(s), rho(t)).
+                            v = do_trans ? Ab[rt + static_cast<std::ptrdiff_t>(rs) * lda]
+                                         : Ab[rs + static_cast<std::ptrdiff_t>(rt) * lda];
+                            if (do_conj) v = sycl_device::dev_conj(v);
+                        }
+                        sLc[tri_idx(sr, t)] = v;
+                    }
+                }
+
+                for (int sr = lid; sr < N; sr += wg) {
+                    D r = sycl_device::dev_one<D>();
+                    if (sr < n && !unit) {
+                        const D d = sLc[tri_idx(sr, sr)];
+                        r = sycl_device::dev_recip(d);
+                        if (!sycl_device::dev_isfinite(r)) {
+                            sycl::atomic_ref<int, sycl::memory_order::relaxed,
+                                             sycl::memory_scope::work_group,
+                                             sycl::access::address_space::local_space>(sDiv[0])
+                                .store(1);
+                            r = sycl_device::dev_one<D>();
+                        }
+                    }
+                    sRd[sr] = r;
+                }
+
+                sycl::group_barrier(it.get_group());
+                const bool divide = (sDiv[0] != 0);
+
+                // ---- Prefetch this thread's rows of B ----------------------
+                // ALL of them, up front, which is what makes the access
+                // coalesced: at local index m the eight lanes of a solve want
+                // eight consecutive rows of one column. Doing the load lazily
+                // inside the recurrence would touch one row per step and throw
+                // that away.
+                const auto row_of = [&](int s_can) { return fwd ? s_can : (n - 1 - s_can); };
+
+                D acc[NL];
+#pragma unroll
+                for (int m = 0; m < NL; ++m) {
+                    const int s_can = w + m * W;
+                    D v{};
+                    if (live && s_can < n) {
+                        v = sycl_device::dev_mul(
+                            alpha_d,
+                            Bb[row_of(s_can) + static_cast<std::ptrdiff_t>(u) * ldb]);
+                    }
+                    acc[m] = v;
+                }
+
+                // ---- The recurrence ----------------------------------------
+                auto sg = it.get_sub_group();
+                const int sg_lane = static_cast<int>(sg.get_local_linear_id());
+                const int sg_base = (sg_lane / W) * W;   // lane 0 of this solve
+
+#pragma unroll
+                for (int m = 0; m < NL; ++m) {
+                    for (int wblk = 0; wblk < W; ++wblk) {
+                        const int t = wblk + m * W;
+
+                        // The owner finalises its row. m is the OUTER unrolled
+                        // index, so acc[m] is a register, not an address.
+                        D cand{};
+                        if (w == wblk) {
+                            D v = acc[m];
+                            if (!unit) {
+                                v = divide ? sycl_device::dev_div(v, sLc[tri_idx(t, t)])
+                                           : sycl_device::dev_mul(v, sRd[t]);
+                            }
+                            acc[m] = v;
+                            cand = v;
+                        }
+                        const D x_t = sycl_device::dev_select(sg, cand, sg_base + wblk);
+
+                        // Rows i = w + nn*W with i > t. nn > m is unconditional;
+                        // nn == m holds only when w > wblk.
+                        if (w > wblk) {
+                            sycl_device::fma_acc_neg(acc[m], sLc[tri_idx(w + m * W, t)], x_t);
+                        }
+#pragma unroll
+                        for (int nn = m + 1; nn < NL; ++nn) {
+                            sycl_device::fma_acc_neg(acc[nn], sLc[tri_idx(w + nn * W, t)], x_t);
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int m = 0; m < NL; ++m) {
+                    const int s_can = w + m * W;
+                    if (live && s_can < n) {
+                        Bb[row_of(s_can) + static_cast<std::ptrdiff_t>(u) * ldb] = acc[m];
+                    }
+                }
+            });
+    });
+
+    return ctx.get_event();
+}
+
+// The orders V3 serves, and the only side it serves. Returns 0 when the
+// cooperative path does not apply, so callers fall back to V1 + blocking.
+template <typename T>
+inline int trsm_coop_order(Side side) {
+    using D = typename sycl_device::DevMap<T>::type;
+    if (side != Side::Left) return 0;
+    if constexpr (sizeof(D) <= 4) return 128;
+    else return 0;
+}
+
+template <typename T>
+Event trsm_native_coop_dispatch(Queue& ctx,
+                                const MatrixView<T, MatrixFormat::Dense>& A,
+                                const MatrixView<T, MatrixFormat::Dense>& B,
+                                T alpha, Uplo uplo, Transpose transA, Diag diag) {
+    return trsm_native_coop<T, 128, 8, Side::Left>(ctx, A, B, alpha, uplo, transA, diag);
+}
