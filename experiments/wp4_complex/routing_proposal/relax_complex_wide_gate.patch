     // worth 3.6-7.7x over the fallback in a vendor-free build.
-    if constexpr (!std::is_same_v<T, float>) {
+    if constexpr (is_std_complex_v<T>) {
+        // ROUTE BY WHAT THE KERNEL CAN RUN, NOT BY WHAT ITS FAST LEG NEEDS.
+        // Identical defect to the 128x128 float case fixed in 3f0afbd (see the
+        // comment at :523-544). can_use_64x64_k16_wide_fast_path is the
+        // AlignedFastPath LEG's predicate; the dispatcher at :801-807
+        // re-evaluates it and picks <true>/<false> itself, so a call that fails
+        // it still runs THIS kernel on its predicated leg. Consulting it here
+        // did not demote such a call to that leg -- it handed the call to
